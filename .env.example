BINANCE_TESTNET=true
# Binance AK/SK are managed in the trading_accounts table from the account UI.
# Keep this encryption key stable across restarts/deployments. If omitted, the
# application uses the local .account_secret.key file, which must be preserved.
ACCOUNT_SECRET_KEY=
ALPHA_FUTURES_MARKET_ENV=mainnet
ALPHA_STRATEGY_V2_ENABLED=false
ALPHA_STRATEGY_V2_MODE=shadow
ALPHA_LEGACY_ENTRY_ENABLED=false
ALPHA_V2_TESTNET_RULE_FALLBACK=true
ALPHA_FAST_INTERVAL_SECONDS=60
ALPHA_DERIVATIVES_INTERVAL_MIN=5
# Optional read-only JSON feed compatible with the Binance Square collector.
# Binance does not provide a stable official read API, so leave empty unless a
# maintained internal proxy/feed is available.
ALPHA_SQUARE_FEED_URL=
ALPHA_SQUARE_INTERVAL_MIN=5
ALPHA_STRATEGY_RETENTION_DAYS=90
DUNE_API_KEY=
DUNE_QUERY_ID=7450094
DB_PASSWORD=alphadog123

# AI entry-quality rollout: shadow records decisions without changing orders.
AI_EXECUTION_MODE=shadow

# Required for all state-changing API operations. start.sh creates a private
# runtime token automatically when this value is left empty.
DARK_HORSE_API_TOKEN=
# Keep internal services loopback-only when Nginx is on the same server.
DARK_HORSE_SERVICE_HOST=127.0.0.1
DARK_HORSE_FRONTEND_HOST=127.0.0.1
# Comma-separated origins only when a separate frontend origin is required.
DARK_HORSE_CORS_ORIGINS=
# Keep at 1.0 until shadow and controlled live validation pass.
AI_MAX_POSITION_FACTOR=1.0
# Public market-data endpoints. Override these when the deployment network
# cannot reach Binance mainnet directly. Keep DATA_ENV aligned with the
# futures endpoint so mainnet and testnet candles remain isolated.
BINANCE_SPOT_DATA_URL=https://api.binance.com
BINANCE_FUTURES_DATA_URL=https://fapi.binance.com
BINANCE_FUTURES_DATA_ENV=mainnet

# Unified closed 1m candle pipeline. Complete aggregates are published to the
# strategy candle tables, replacing duplicate multi-interval collectors.
UNIFIED_CANDLE_PIPELINE_ENABLED=true
MINUTE_PIPELINE_ENABLED=true
MINUTE_PIPELINE_MODE=live
MINUTE_BOOTSTRAP_MINUTES=180
MINUTE_RETENTION_DAYS=4
MINUTE_REST_CONCURRENCY=8
MINUTE_ALPHA_CONCURRENCY=4
MINUTE_ALPHA_OFFSET_SECONDS=3
MINUTE_WS_RECONNECT_SECONDS=600
MINUTE_UNIVERSE_REFRESH_SECONDS=600
MINUTE_GAP_REPAIR_INTERVAL_SECONDS=30
MINUTE_FUTURES_FALLBACK_AFTER_SECONDS=90
